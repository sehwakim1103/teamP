<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#FFF8E7">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="24dp">

        <TextView
            android:id="@+id/tvWeather"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="날씨 불러오는 중..."
            android:textSize="14sp"
            android:background="#FFFFFF"
            android:padding="10dp"
            android:gravity="center" />

        <TextView
            android:id="@+id/tvStage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1단계 아기 펫"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginTop="16dp" />

        <FrameLayout
            android:id="@+id/frameHomePet"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp">

            <ImageView
                android:id="@+id/ivPet"
                android:layout_width="160dp"
                android:layout_height="160dp"
                android:src="@drawable/pet1"
                android:scaleType="fitCenter" />

            <ImageView
                android:id="@+id/ivPetItem"
                android:layout_width="81dp"
                android:layout_height="73dp"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginStart="30dp"
                android:layout_marginTop="0dp"
                android:scaleType="fitCenter" />
        </FrameLayout>

        <TextView
            android:id="@+id/tvSpeech"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="오늘도 왔네!"
            android:textSize="16sp"
            android:background="#FFFFFF"
            android:padding="12dp"
            android:layout_marginTop="8dp" />

        <ProgressBar
            android:id="@+id/pbXp"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="16dp"
            android:max="1000000"
            android:progress="0"
            android:layout_marginTop="24dp" />

        <TextView
            android:id="@+id/tvXp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0 / 1000000XP"
            android:layout_marginTop="4dp" />

        <LinearLayout
            android:id="@+id/layoutGoal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="12dp"
            android:layout_marginTop="16dp">

            <TextView
                android:id="@+id/tvHomeGoalName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=" 목표를 설정해 주세요 👉"
                android:textSize="15sp"
                android:textStyle="bold" />

            <ProgressBar
                android:id="@+id/pbHomeGoal"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="12dp"
                android:max="100"
                android:layout_marginTop="6dp" />

            <TextView
                android:id="@+id/tvHomeGoalStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="13sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <RadioGroup
            android:id="@+id/rgType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="16dp">

            <RadioButton
                android:id="@+id/rbSaving"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="저축" />

            <RadioButton
                android:id="@+id/rbIncome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="수입" />

            <RadioButton
                android:id="@+id/rbExpense"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="지출" />
        </RadioGroup>

        <EditText
            android:id="@+id/etAmount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="금액 (원)"
            android:inputType="number" />

        <EditText
            android:id="@+id/etCategory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="항목 (예: 식비, 교통, 용돈) - 지출/수입일 때"
            android:inputType="text" />

        <Button
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="기록하기"
            android:layout_marginTop="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp">

            <Button
                android:id="@+id/btnReport"
                android:layout_width="0dp"
                android:layout_height="90dp"
                android:layout_weight="1"
                android:text="월간 리포트"
                android:background="@drawable/btn_square"
                android:textColor="#FFF8E7"
                android:layout_marginEnd="6dp" />

            <Button
                android:id="@+id/btnHistory"
                android:layout_width="0dp"
                android:layout_height="90dp"
                android:layout_weight="1"
                android:text="저축 기록"
                android:background="@drawable/btn_square"
                android:textColor="#FFF8E7"
                android:layout_marginStart="6dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="12dp">

            <Button
                android:id="@+id/btnGoal"
                android:layout_width="0dp"
                android:layout_height="90dp"
                android:layout_weight="1"
                android:text="목표"
                android:background="@drawable/btn_square"
                android:textColor="#FFF8E7"
                android:layout_marginEnd="6dp" />

            <Button
                android:id="@+id/btnCloset"
                android:layout_width="0dp"
                android:layout_height="90dp"
                android:layout_weight="1"
                android:text="펫 옷장"
                android:background="@drawable/btn_square"
                android:textColor="#FFF8E7"
                android:layout_marginStart="6dp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnLogout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="로그아웃"
            android:layout_marginTop="16dp" />
    </LinearLayout>
</ScrollView>