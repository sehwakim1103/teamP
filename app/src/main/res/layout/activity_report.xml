<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF8E7">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/tvReportTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="📊 월간 리포트"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvIncome"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="이번 달 총수입: 0원"
            android:textSize="17sp"
            android:layout_marginTop="24dp" />

        <TextView
            android:id="@+id/tvExpense"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="이번 달 총지출: 0원"
            android:textSize="17sp"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/tvSaving"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="이번 달 총저축: 0원"
            android:textSize="17sp"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/tvTopCategory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="가장 많이 소비한 항목: -"
            android:textSize="17sp"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/tvDiff"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="지난달 대비 저축: -"
            android:textSize="17sp"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/tvPetReview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🐾 펫이 이번 달을 돌아보는 중..."
            android:textSize="16sp"
            android:background="#FFFFFF"
            android:padding="16dp"
            android:layout_marginTop="24dp" />

        <Button
            android:id="@+id/btnAddIncome"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="➕ 수입 기록하기"
            android:layout_marginTop="24dp" />

        <Button
            android:id="@+id/btnAddExpense"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="➖ 지출 기록하기"
            android:layout_marginTop="8dp" />

        <Button
            android:id="@+id/btnReportBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="← 홈으로"
            android:layout_marginTop="16dp" />
    </LinearLayout>
</ScrollView>